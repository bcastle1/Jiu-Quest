{
  "name": "jiuquest",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "test:unreal-native": "node --test unreal/native-runtime/Tests/control-gateway.test.cjs unreal/native-runtime/Tests/browser-control.test.mjs",
    "unity:build": "pwsh -NoProfile -File tools/build_unity_preview.ps1",
    "unity:test": "pwsh -NoProfile -File tools/build_unity_preview.ps1 -TestOnly",
    "optimize:bjj": "powershell -ExecutionPolicy Bypass -File tools/optimize_bjj_glbs.ps1",
    "release:pack": "node tools/unity_release.mjs pack",
    "release:restore": "node tools/unity_release.mjs restore",
    "release:build": "node tools/build_release.mjs",
    "release:verify": "node tools/unity_release.mjs verify-site",
    "test:browser": "node tools/test_unreal_character_preview.mjs && node tools/test_unreal_athlete.mjs && node tools/test_unreal_clip_stage.mjs && node tools/test_unreal_technique_clips.mjs && node tools/test_stance_picker.mjs && node tools/test_unreal_position_still.mjs && node tools/test_showcase_cards.mjs && node tools/test_unity_startup_telemetry.mjs && node tools/test_unity_canvas_lifecycle.mjs && node tools/test_unity_browser.mjs && node tools/test_keyboard_polish.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "lucide-react": "^0.562.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "three": "^0.185.0",
    "vite": "^7.3.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "4.4.1",
    "playwright": "1.64.1"
  }
}
